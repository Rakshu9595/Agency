# Server Port
PORT=5000

# Environment (development | production | test)
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/agency_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_DATABASE_CONNECTION

# Primary Frontend Application Origin for CORS
FRONTEND_URL=http://localhost:5500

# Additional Allowed Origins for CORS (comma-separated, optional)
ADDITIONAL_ALLOWED_ORIGINS=http://127.0.0.1:5500

# Razorpay Payment Gateway Credentials (Test or Live)
# Get from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# Razorpay Webhook Secret
# Set in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Cryptographic Session & JWT Secret
SESSION_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Rate Limiting for Public Submissions (window in milliseconds)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10
