{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/services/landing-page-development", "destination": "/pages/landing-page-development.html" },
    { "source": "/services/business-website-development", "destination": "/pages/business-website-development.html" },
    { "source": "/services/ecommerce-development", "destination": "/pages/ecommerce-development.html" },
    { "source": "/services/custom-web-applications", "destination": "/pages/custom-web-applications.html" },
    { "source": "/services/website-redesign", "destination": "/pages/website-redesign.html" },
    { "source": "/services/website-maintenance", "destination": "/pages/website-maintenance.html" },
    { "source": "/services/ui-ux-design", "destination": "/pages/ui-ux-design.html" },
    { "source": "/blog/website-development-cost-india", "destination": "/pages/blog-website-cost-india.html" },
    { "source": "/blog/startup-website-guide", "destination": "/pages/blog-startup-website-guide.html" },
    { "source": "/blog/custom-website-vs-website-builder", "destination": "/pages/blog-custom-vs-builder.html" },
    { "source": "/blog/how-to-write-website-project-brief", "destination": "/pages/blog-website-brief-guide.html" },
    { "source": "/blog/website-redesign-checklist", "destination": "/pages/blog-website-redesign-checklist.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(css|js|assets)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
