# Software Agency Website - Master Environment Configuration
# Copy this file to backend/.env and customize with your credentials

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5500
ADDITIONAL_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:3000

# MongoDB Atlas Database Connection
MONGODB_URI=mongodb+srv://YOUR_DATABASE_CONNECTION

# Razorpay Payment Gateway (Test or Live mode)
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Security & Session Secrets (Min 32 characters)
SESSION_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
